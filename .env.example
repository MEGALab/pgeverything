# Copy to .env and adjust.
POSTGRES_PASSWORD=postgres
# NOTE: if you change POSTGRES_DB, you MUST also change cron.database_name in
# docker-compose.yml (and pgeverything.conf) to match — pg_cron requires the two to be
# equal or first-boot init fails with "CREATE EXTENSION pg_cron must be run in the
# database named by cron.database_name".
POSTGRES_DB=pgeverything
PGE_PORT=5432
# Set to "true" to enable PostGIS (geospatial) at first boot.
PGE_ENABLE_POSTGIS=false

# PostgreSQL memory tuning. Set shared_buffers to ~25% of the machine's RAM
# (e.g. 2GB on 8GB, 4GB on 16GB). Defaults below are conservative for laptops.
PGE_SHARED_BUFFERS=256MB
PGE_WORK_MEM=16MB
PGE_MAX_CONNECTIONS=100

# pgauth JWT signing secret. !!! CHANGE THIS IN PRODUCTION !!! Anyone with this value
# can forge valid sessions. Seeded into a protected table at first boot by 20-auth.sh.
PGE_JWT_SECRET=CHANGE-ME-INSECURE-DEV-SECRET
# Set to enable direct logins as the non-superuser app_user role (leave empty = NOLOGIN,
# usable only via SET ROLE from a superuser session).
PGE_APP_USER_PASSWORD=

# --- Physical replication (REPLICA host only) ---
# Set by `make replicant` (it prompts and writes these). Point at the REMOTE primary.
PGE_PRIMARY_HOST=
PGE_PRIMARY_PORT=5432
PGE_REPL_USER=replicator
PGE_REPL_PASSWORD=
# Host port the replica listens on (use a different port if primary runs on the same host).
PGE_REPLICA_PORT=5432

# pgvault (secrets manager) root key. !!! generate with `openssl rand -hex 32` and CHANGE IN
# PRODUCTION !!! Read at startup by pgsodium (kept out of the DB). Unset = INSECURE dev key.
PGE_VAULT_KEY=
